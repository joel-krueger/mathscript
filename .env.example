# Local Postgres from docker-compose.yml (start with `pnpm db:up`).
# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgresql://mathscript:mathscript@localhost:5432/mathscript
# Separate database used by integration tests; created by docker/postgres/init.
TEST_DATABASE_URL=postgresql://mathscript:mathscript@localhost:5432/mathscript_test
